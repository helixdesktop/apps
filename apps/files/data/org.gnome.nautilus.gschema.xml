<?xml version="1.0" encoding="UTF-8"?>
<!-- GNOME-compatible schemas for the keys Helix Files uses. Install only
     when the schemas are not already provided by the system. -->
<schemalist>
  <enum id="org.gnome.nautilus.FolderView">
    <value value="0" nick="list-view"/>
    <value value="1" nick="icon-view"/>
  </enum>
  <enum id="org.gnome.nautilus.ClickPolicy">
    <value value="0" nick="single"/>
    <value value="1" nick="double"/>
  </enum>
  <enum id="org.gnome.nautilus.SpeedTradeoff">
    <value value="0" nick="always"/>
    <value value="1" nick="local-only"/>
    <value value="2" nick="never"/>
  </enum>
  <enum id="org.gnome.nautilus.SortOrder">
    <value value="0" nick="name"/>
    <value value="1" nick="size"/>
    <value value="2" nick="type"/>
    <value value="3" nick="mtime"/>
    <value value="4" nick="atime"/>
    <value value="5" nick="btime"/>
    <value value="6" nick="starred"/>
  </enum>
  <enum id="org.gnome.nautilus.CompressionFormat">
    <value value="0" nick="zip"/>
    <value value="1" nick="tar.xz"/>
    <value value="2" nick="7z"/>
    <value value="3" nick="encrypted_zip"/>
  </enum>
  <enum id="org.gnome.nautilus.DateTimeFormat">
    <value value="0" nick="simple"/>
    <value value="1" nick="detailed"/>
  </enum>
  <enum id="org.gnome.nautilus.ListZoomLevel">
    <value value="0" nick="small"/>
    <value value="1" nick="medium"/>
    <value value="2" nick="large"/>
  </enum>
  <enum id="org.gnome.nautilus.IconZoomLevel">
    <value value="0" nick="small"/>
    <value value="1" nick="small-plus"/>
    <value value="2" nick="medium"/>
    <value value="3" nick="large"/>
    <value value="4" nick="extra-large"/>
  </enum>

  <schema path="/org/gnome/nautilus/preferences/" id="org.gnome.nautilus.preferences">
    <key name="default-folder-viewer" enum="org.gnome.nautilus.FolderView"><default>'icon-view'</default><summary>Default folder viewer</summary></key>
    <key type="b" name="show-hidden-files"><default>false</default><summary>Show hidden files</summary></key>
    <key name="click-policy" enum="org.gnome.nautilus.ClickPolicy"><default>'double'</default><summary>Click policy</summary></key>
    <key type="b" name="show-delete-permanently"><default>false</default><summary>Show a Delete Permanently command</summary></key>
    <key type="b" name="show-create-link"><default>false</default><summary>Show a Create Link command</summary></key>
    <key name="recursive-search" enum="org.gnome.nautilus.SpeedTradeoff"><default>'local-only'</default><summary>Where to search recursively</summary></key>
    <key name="show-image-thumbnails" enum="org.gnome.nautilus.SpeedTradeoff"><default>'local-only'</default><summary>When to show thumbnails</summary></key>
    <key name="default-sort-order" enum="org.gnome.nautilus.SortOrder"><default>'name'</default><summary>Default sort order</summary></key>
    <key type="b" name="default-sort-in-reverse-order"><default>false</default><summary>Reverse sort order</summary></key>
    <key name="date-time-format" enum="org.gnome.nautilus.DateTimeFormat"><default>'simple'</default><summary>Date and time format</summary></key>
    <key type="b" name="always-use-location-entry"><default>false</default><summary>Always use the location entry</summary></key>
    <key type="b" name="mouse-use-extra-buttons"><default>true</default><summary>Use extra mouse buttons for navigation</summary></key>
    <key type="u" name="mouse-back-button"><default>8</default><summary>Mouse button for going back</summary></key>
    <key type="u" name="mouse-forward-button"><default>9</default><summary>Mouse button for going forward</summary></key>
  </schema>

  <schema path="/org/gnome/nautilus/window-state/" id="org.gnome.nautilus.window-state">
    <key type="(ii)" name="initial-size"><default>(890, 550)</default><summary>Initial window size</summary></key>
    <key type="b" name="maximized"><default>false</default><summary>Window maximized</summary></key>
  </schema>

  <schema path="/org/gnome/nautilus/list-view/" id="org.gnome.nautilus.list-view">
    <key name="default-zoom-level" enum="org.gnome.nautilus.ListZoomLevel"><default>'medium'</default><summary>List view zoom level</summary></key>
    <key type="as" name="default-visible-columns"><default>['name', 'size', 'date_modified']</default><summary>Visible list columns</summary></key>
  </schema>

  <schema path="/org/gnome/nautilus/icon-view/" id="org.gnome.nautilus.icon-view">
    <key name="default-zoom-level" enum="org.gnome.nautilus.IconZoomLevel"><default>'medium'</default><summary>Icon view zoom level</summary></key>
  </schema>

  <schema path="/org/gnome/nautilus/compression/" id="org.gnome.nautilus.compression">
    <key name="default-compression-format" enum="org.gnome.nautilus.CompressionFormat"><default>'zip'</default><summary>Default format for compressing files</summary></key>
  </schema>
</schemalist>
