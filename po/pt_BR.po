msgstr "O dispositivo ou arquivo está em uso."

#: crates/helix-app-common/src/errors.rs:64
msgid "This is not supported here."
msgstr "Isso não é compatível aqui."

#: crates/helix-app-common/src/errors.rs:65
msgid "The network or server cannot be reached."
msgstr "Não é possível acessar a rede ou o servidor."

#: crates/helix-app-common/src/links.rs:123
msgid "Open This Link?"
msgstr "Abrir este link?"

#: crates/helix-app-common/src/links.rs:124
msgid ""
"The link points to the location below, which is not a web page. Opening it "
"may access files or network shares, or start another application."
msgstr ""
"O link aponta para o local abaixo, que não é uma página web. Abri-lo pode "
"acessar arquivos ou compartilhamentos de rede, ou iniciar outro aplicativo."

#: crates/helix-eds/src/client.rs:66
msgid "“{name}” is read-only"
msgstr "“{name}” é somente leitura"

#: crates/helix-eds/src/client.rs:68
msgid "“{name}” cannot be removed"
msgstr "“{name}” não pode ser removido"

#: crates/helix-eds/src/client.rs:70
msgid "The contact could not be read"
msgstr "Não foi possível ler o contato"

#: crates/helix-eds/src/source.rs:220
msgid "Enter the address of the calendar"
msgstr "Digite o endereço da agenda"

#: crates/helix-eds/src/source.rs:221
msgid "The address must not contain spaces"
msgstr "O endereço não deve conter espaços"

#: crates/helix-eds/src/source.rs:222
msgid "The address must start with http://, https:// or webcal://"
msgstr "O endereço deve começar com http://, https:// ou webcal://"

#: crates/helix-eds/src/source.rs:223
msgid "The address has no server name"
msgstr "O endereço não tem nome de servidor"

#: crates/helix-eds/src/source.rs:224
msgid "The server name is not valid"
msgstr "O nome do servidor não é válido"

#: crates/helix-eds/src/source.rs:225
msgid "The port number is not valid"
msgstr "O número da porta não é válido"

#: crates/helix-eds/src/source.rs:226
msgid "Remove the user name and password from the address"
msgstr "Remova o nome de usuário e a senha do endereço"

